# ======================================
# FaceCode Guardian Network
# Configuración de Variables de Entorno
# ======================================

# ----------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------
# Para obtener estos valores:
# 1. Ve a tu proyecto en https://app.supabase.com
# 2. Navega a Settings > API
# 3. Copia la URL del proyecto y la clave anon/public

# URL del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon/public de Supabase
# IMPORTANTE: Esta clave es segura para usar en el cliente
# Las políticas de seguridad (RLS) de Supabase protegen tus datos
SUPABASE_ANON_KEY=tu-clave-anon-aqui

# ----------------------------------------
# SUPABASE SERVICE ROLE (Opcional)
# ----------------------------------------
# Solo para operaciones administrativas del servidor
# ADVERTENCIA: ¡No expongas esta clave en el frontend!
# Omite el bypass de RLS, úsala solo en backend seguro
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ----------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------
# NODE_ENV=development
# PORT=3000

# ----------------------------------------
# GUARDIAN NETWORK SETTINGS
# ----------------------------------------
# Configuración específica para el Guardian Network
# GUARDIAN_NODE_ID=
# ETHICAL_MONITORING_ENABLED=true
# AUDIT_LOG_LEVEL=info
