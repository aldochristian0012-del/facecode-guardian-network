# FaceCode Guardian Network - Environment Configuration
# ======================================================

# API Settings
API_TITLE="FaceCode Guardian Network API"
API_VERSION="0.1.0"
API_PREFIX="/api/v1"
DEBUG=false

# Server Settings
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# Security
API_KEY=""
CORS_ORIGINS=["*"]

# MediaPipe Settings
MEDIAPIPE_MODEL_SELECTION=0
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5

# Ethical Limits
MAX_FACES_PER_REQUEST=10
MAX_REQUESTS_PER_MINUTE=30
REQUIRE_HUMAN_APPROVAL=true
ENABLE_BIAS_DETECTION=true

# Audit Settings
AUDIT_LOG_PATH="./logs/audit"
ENABLE_AUDIT_LOG=true
LOG_RETENTION_DAYS=90

# Database (optional)
DATABASE_URL=""

# Compliance
GDPR_COMPLIANT=true
EU_AI_ACT_COMPLIANT=true
EAA_COMPLIANT=true
