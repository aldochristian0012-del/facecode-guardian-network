# ===================================================
# SUPABASE CONFIGURATION
# ===================================================
# Obtén estas credenciales desde: https://app.supabase.com
# Project Settings > API

# URL base de tu proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon key) - Segura para uso en frontend
# Esta clave respeta las Row Level Security (RLS) policies
SUPABASE_ANON_KEY=tu_anon_key_aqui

# Clave de servicio (service role key) - SOLO PARA BACKEND
# ⚠️  ADVERTENCIA: Esta clave bypasea RLS. NUNCA la expongas en el cliente.
# Úsala solo en entornos de servidor seguros (Node.js, Edge Functions, etc.)
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# ===================================================
# NODE ENVIRONMENT
# ===================================================
NODE_ENV=development

# ===================================================
# CONFIGURACIÓN OPCIONAL
# ===================================================
# Puerto del servidor (si aplica)
PORT=3000

# Nivel de logs
LOG_LEVEL=info
